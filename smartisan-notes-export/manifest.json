{
  "manifest_version": 3,
  "name": "锤子便签 Markdown 导出",
  "description": "一键导出锤子便签全部笔记为 Markdown 格式",
  "version": "1.0.0",
  "permissions": [],
  "host_permissions": [
    "*://cloud.smartisan.com/*",
    "*://note.smartisan.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://cloud.smartisan.com/*",
        "*://note.smartisan.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
